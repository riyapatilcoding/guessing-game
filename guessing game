import random
secret = random.randint(1,50)

attempts = 0
max_attempts = 5
won = False

print("Welcome to Guess the Number")
print("The computer has choose a number between 1-50, you have 5 lives to guess the number.")

while attempts <= max_attempts:
    guess = int(input(f"\nAttempt {attempts}/ {max_attempts} Enter your guess:"))

    attempts += 1

    if guess == secret:
        won = True
        print('you won')
    else:
        difference = abs(secret-guess)
        if difference >= 20:
            hint = "ice cold"
        elif difference>= 10:
            hint= "cold"
        elif difference >= 5:
            hint= "warm"
        else:
            hint="hot"
        print (f"Incorrect! You are {hint}")

        remaining_lives = max_attempts - attempts
        if remaining_lives > 0:
              print("Lives left:", end="")
              for i in range (remaining_lives):
                print("heart:", end="")
                print()

                continue
    
if not won:
    print(f'\n game over, the secret number was {secret}')

